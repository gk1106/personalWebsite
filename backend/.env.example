# Copy to .env and fill in real values before running `docker compose up`.
# .env is gitignored — never commit it. This file holds no secrets, only
# placeholders and safe defaults for non-sensitive values.

# --- Database (used by both the db and backend services) ---
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
# Required — docker compose refuses to start without it.
POSTGRES_PASSWORD=portfolio
# Host port Postgres is published on (container always uses 5432 internally).
POSTGRES_PORT=5432

# --- Backend ---
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Comma-separated list of allowed frontend origins, e.g.:
# https://yourdomain.com,https://www.yourdomain.com
# Required — never defaults to a wildcard or a hardcoded domain.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# HS256 signing key for admin JWTs — must be a random string at least 32
# bytes long. Generate one with: openssl rand -base64 48
# Required — the backend fails fast without it in the prod profile.
JWT_SECRET=90869e3a559fb73ba6b9fd0395f89e455a082a846b6cb221c711bdba8a9fec8a

# Access token lifetime in minutes.
JWT_EXPIRATION_MINUTES=60

# One-time admin bootstrap — leave both blank after the first admin account
# exists. If set, both must be set together (enforced by the app itself).
ADMIN_USERNAME=gkadmin
ADMIN_PASSWORD=gkadmin

# --- Portfolio chat assistant (Spring AI + OpenAI) ---
# Required — the backend fails fast without it in the prod profile. Never a
# placeholder/dev key here — get a real key from https://platform.openai.com.
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI chat model the assistant calls. Optional — defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini
